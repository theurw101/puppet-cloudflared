{
  "name": "theurw101-cloudflared",
  "version": "0.1.1",
  "author": "theurw101",
  "summary": "Install and manage Cloudflare Tunnel (cloudflared)",
  "license": "Apache-2.0",
  "source": "https://github.com/theurw101/puppet-cloudflared",
  "issues_url": "https://github.com/theurw101/puppet-cloudflared/issues",
  "project_page": "https://github.com/theurw101/puppet-cloudflared",
  "tags": [
    "cloudflare",
    "cloudflared",
    "tunnel",
    "networking",
    "zerotrust"
  ],
  "dependencies": [
